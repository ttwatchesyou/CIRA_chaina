# SQLite is the default for local development. Switch this to a PostgreSQL URL later
# without changing the application data model.
DATABASE_URL="file:./dev.db"

# Root used by upload, dataset, training, and model storage services.
STORAGE_ROOT="./storage"

# Base URL used by a future training worker when it downloads datasets.
APP_URL="http://localhost:3000"

# Optional fallback URL for mobile-upload QR codes. Normally links are created
# dynamically from the URL that opened the site, including reverse-proxy headers.
# Set this only when the server itself sees requests as localhost.
# PUBLIC_APP_URL="https://vision.example.com"

# Token shared only by the Web Server and Training Worker agents.
# Change this before allowing another computer to connect.
WORKER_API_TOKEN="ivp-local-worker-token"

# These values are read by `yarn worker`. On computer B, point the URL to
# computer A's Tailscale IP or MagicDNS name (never localhost).
WORKER_SERVER_URL="http://localhost:3000"
WORKER_KEY="training-pc-01"
WORKER_DATA_DIR="./storage/worker-cache"
WORKER_MODE="real"
WORKER_PYTHON=".venv/bin/python"
WORKER_HEARTBEAT_MS="8000"
WORKER_POLL_MS="3000"

# Optional: สำหรับเครื่อง NVIDIA ให้เลือก CUDA build จากหน้า PyTorch แล้วใส่ URL ที่นี่
# ก่อนรัน yarn worker:setup เช่น https://download.pytorch.org/whl/cu128
# WORKER_TORCH_INDEX_URL="https://download.pytorch.org/whl/cu128"

# When localhost:3000 is occupied, the Worker checks the next local ports
# automatically. Set the number of additional ports to check here.
WORKER_DISCOVERY_PORT_COUNT="10"

# Optional fallback for the Dataset download URL returned to remote workers.
# Normally this is derived dynamically from the Worker request (and proxy headers).
# Set this only when the server itself sees the Worker request as localhost.
# WORKER_PUBLIC_APP_URL="http://100.x.y.z:3000"
