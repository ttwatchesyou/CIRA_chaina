{
  "name": "internal-vision-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "dev": "yarn workspace @internal-vision/web dev",
    "build": "yarn workspace @internal-vision/web build",
    "start": "yarn workspace @internal-vision/web start",
    "lint": "yarn workspace @internal-vision/web lint",
    "typecheck": "yarn workspace @internal-vision/web typecheck && yarn workspace @internal-vision/worker typecheck",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "worker": "yarn workspace @internal-vision/worker start",
    "worker:setup": "node scripts/setup-worker.mjs"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "prisma": "6.10.1"
  },
  "dependencies": {
    "@prisma/client": "6.10.1"
  }
}
